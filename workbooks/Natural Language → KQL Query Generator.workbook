{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "# Natural Language → KQL Query Generator\n\nType a question in plain English and this workbook will generate a validated KQL query against your Sentinel workspace.\n\n**Examples:**\n- \"Show me all sign-in failures for user john.doe@contoso.com in the last 7 days\"\n- \"Find all devices that communicated with IP 10.0.0.50\"\n- \"List all security alerts with high severity from the past 24 hours\"\n- \"Show me PowerShell execution events on server WS01\""
      },
      "name": "header-text"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "param-question",
            "version": "KqlParameterItem/1.0",
            "name": "NLQuestion",
            "label": "Ask a question",
            "type": 1,
            "description": "Enter your question in plain English. The system will convert it to a KQL query.",
            "isRequired": true,
            "isGlobal": true,
            "typeSettings": {
              "isSearchBox": true,
              "multiLine": true,
              "multiLineHeight": 5
            },
            "timeContext": {
              "durationMs": 86400000
            },
            "value": "List all security alerts with high severity "
          }
        ],
        "style": "formHorizontal",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "10152279-36bc-4c36-901a-c9e9c269f058",
            "version": "KqlParameterItem/1.0",
            "name": "SubmittedQuestion",
            "type": 1,
            "isGlobal": true,
            "isHiddenWhenLocked": true,
            "value": "List all security alerts with high severity "
          }
        ],
        "style": "above",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "name": "parameters-hidden"
    },
    {
      "type": 11,
      "content": {
        "version": "LinkItem/1.0",
        "style": "list",
        "links": [
          {
            "id": "submit-button",
            "cellValue": "SubmittedQuestion",
            "linkTarget": "parameter",
            "linkLabel": "Generate KQL Query",
            "subTarget": "{NLQuestion}",
            "preText": "",
            "postText": "",
            "style": "primary"
          }
        ]
      },
      "name": "submit-link",
      "styleSettings": {
        "margin": "0 0 16px 0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "{\"version\":\"CustomEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"POST\",\"url\":\"https://<logic-app-callback-url>?api-version=2016-10-01&sp=%2Ftriggers%2FHTTP_Request_from_Workbook%2Frun&sv=1.0&sig=\",\"contentType\":\"text/plain\",\"urlParams\":[{\"key\":\"question\",\"value\":\"{SubmittedQuestion}\"}],\"transformers\":null}",
        "size": 3,
        "queryType": 10,
        "visualization": "card",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Column",
              "formatter": 1
            }
          ]
        },
        "textSettings": {
          "style": "markdown"
        }
      },
      "name": "query - 6"
    }
  ],
  "fallbackResourceIds": [
    "/subscriptions/<subscription-id>/resourcegroups/<resource-group>/providers/microsoft.operationalinsights/workspaces/<workspace-name>"
  ],
  "fromTemplateId": "sentinel-UserWorkbook",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}