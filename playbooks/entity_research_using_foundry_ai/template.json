{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workflows_entity_research_using_foundry_ai_name": {
      "defaultValue": "entity-research-using-foundry-ai",
      "type": "String"
    }
  },
  "variables": {
    "AzureSentinelConnectionName": "azuresentinel-2",
    "AzureSentinelConnectionName2": "azuresentinel"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "customParameterValues": {},
        "parameterValueSet": {
          "name": "managedIdentityAuth",
          "values": {}
        },
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName2')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName2')]",
        "customParameterValues": {},
        "parameterValueSet": {
          "name": "managedIdentityAuth",
          "values": {}
        },
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('workflows_entity_research_using_foundry_ai_name')]",
      "location": "[resourceGroup().location]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "metadata": {
            "notes": {}
          },
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                  }
                },
                "body": {
                  "callback_url": "@listCallbackUrl()"
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "HTTP_-_Call_Foundry": {
              "runAfter": {
                "Get_URLs": [
                  "Succeeded"
                ]
              },
              "type": "Http",
              "inputs": {
                "uri": "https://soc-ai-llm-api.openai.azure.us/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview",
                "method": "POST",
                "body": {
                  "messages": [
                    {
                      "role": "system",
                      "content": "You are a cybersecurity incident enrichment assistant. Your purpose is to provide concise, factual, and investigation-relevant context for entities such as IP addresses, domains, URLs, file hashes, user agents, email addresses, and other indicators.\n\nYou will analyze the provided entities and return any meaningful public or commonly known information that could assist an analyst during an investigation.\n\n### Output Requirements\n- Return a short, structured comment suitable for an incident record\n- Be brief but informative\n- Focus only on non-trivial, high-value insights\n- Do not repeat the input values unless necessary for clarity\n- Do not include filler, explanations, or conversational language\n\n### Content Guidelines\n- Include relevant details such as reputation, known malicious activity, threat actor associations, infrastructure patterns, or historical context\n- If available, include sources (for example: VirusTotal, AbuseIPDB, Microsoft, public threat reports, or other widely recognized intelligence sources)\n- Do not speculate or infer beyond supported information\n- Do not generate or assume unknown data\n\n### Filtering Rules\n- Skip entities that have no meaningful or useful public information\n- If none of the provided entities have useful enrichment, return exactly:\n  \"No meaningful public information found for the provided entities.\"\n\n### Formatting\n- Use simple bullet points or short lines\n- Group findings logically if multiple entities are enriched\n- Keep output optimized for quick analyst review\n\nYour goal is to enhance investigation context, not restate obvious data."
                    },
                    {
                      "role": "user",
                      "content": "Enrich the following entities with any relevant public or known information: @{body('Get_Hosts')}, @{body('Get_URLs')}, @{body('Get_IPs')}, @{body('Get_FileHashes')}. @{body('Get_Accounts')}"
                    }
                  ]
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://cognitiveservices.azure.us"
                }
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "Add_comment_to_incident_(V3)": {
              "runAfter": {
                "HTTP_-_Call_Foundry": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "method": "post",
                "body": {
                  "incidentArmId": "@triggerBody()?['object']?['id']",
                  "message": "<p class=\"editor-paragraph\">@{outputs('HTTP_-_Call_Foundry')?['body']?['choices']?[0]?['message']?['content']}</p>"
                },
                "path": "/Incidents/Comment"
              }
            },
            "Wait_for_Entities": {
              "runAfter": {},
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 3,
                  "unit": "Second"
                }
              },
              "description": "Optional delay recommended for automated trigger, wait for the incident to gather multiple entities. Remove or lower for manual execution."
            },
            "Get_Accounts": {
              "runAfter": {
                "Wait_for_Entities": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/account"
              }
            },
            "Get_FileHashes": {
              "runAfter": {
                "Get_Accounts": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/filehash"
              }
            },
            "Get_IPs": {
              "runAfter": {
                "Get_FileHashes": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/ip"
              }
            },
            "Get_Hosts": {
              "runAfter": {
                "Get_IPs": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/host"
              }
            },
            "Get_URLs": {
              "runAfter": {
                "Get_Hosts": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel-2']['connectionId']"
                  }
                },
                "method": "post",
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "path": "/entities/url"
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel-2": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "azuresentinel-2",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              },
              "azuresentinel": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName2'))]"
      ]
    }
  ]
}