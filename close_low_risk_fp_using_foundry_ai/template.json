{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workflows_close_low_risk_fp_using_foundry_ai_name": {
            "defaultValue": "close-low-risk-fp-using-foundry-ai",
            "type": "String"
        },
        "logAnalyticsWorkspaceName": {
            "defaultValue": "",
            "type": "String"
        }
    },
    "variables": {},
    "resources": [
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('workflows_close_low_risk_fp_using_foundry_ai_name')]",
            "location": "[resourceGroup().location]",
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "metadata": {
                        "notes": {}
                    },
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "Microsoft_Sentinel_incident": {
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "body": {
                                    "callback_url": "@listCallbackUrl()"
                                },
                                "path": "/incident-creation"
                            }
                        }
                    },
                    "actions": {
                        "HTTP_-_Call_Foundry": {
                            "runAfter": {
                                "Run_KQL_Query": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Http",
                            "inputs": {
                                "uri": "https://soc-ai-llm-api.openai.azure.us/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview",
                                "method": "POST",
                                "body": {
                                    "messages": [
                                        {
                                            "role": "system",
                                            "content": "You are a cybersecurity incident triage assistant. Your task is to evaluate low and informational severity incidents only and determine whether they should be closed or left unchanged based on the provided incident details (raw JSON), historical incident trends, general risk evaluation, and any additional grounding if provided. Ignore any incidents that are medium or high severity. Consider whether higher severity is not warranted. This is one indicator that an incident may remain open, but it is not sufficient by itself to recommend closure. Focus on identifying cases that are likely false positives or have historically been closed under similar conditions. Consider factors such as repetition, known benign patterns, prior closure reasons such as false positive, overall risk context, whether the incident is new, whether it has limited historical context, and whether it appears highly intermittent. Incidents with limited history, new patterns, or highly intermittent behavior should generally not be recommended for closure. Use additional grounding if provided, but do not rely on it exclusively. Do not speculate or assume missing data. You MUST return valid JSON only with no additional text or formatting. Output schema: { \"status\": \"<Closed | none>\", \"explanation\": \"<Brief justification including reference to historical trends, grounding, or risk reasoning>\" } Rules: Return \"Closed\" only if the incident aligns with patterns commonly closed as false positive or low risk and there is sufficient historical support for closure. Return \"none\" if no action should be taken. Keep the explanation concise and based only on provided data and known patterns. Do not recommend escalation or severity changes."
                                        },
                                        {
                                            "role": "user",
                                            "content": "Evaluate the following incident for triage action. Incident: @{triggerBody()} Related incidents and trends: @{body('Run_KQL_Query')} Grounding (if available): "
                                        }
                                    ]
                                },
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://cognitiveservices.azure.us"
                                }
                            },
                            "runtimeConfiguration": {
                                "contentTransfer": {
                                    "transferMode": "Chunked"
                                }
                            }
                        },
                        "Add_comment_to_incident_(V3)": {
                            "runAfter": {
                                "HTTP_-_Call_Foundry": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": {
                                    "incidentArmId": "@triggerBody()?['object']?['id']",
                                    "message": "<p class=\"editor-paragraph\">@{json(outputs('HTTP_-_Call_Foundry')?['body']?['choices']?[0]?['message']?['content'])?['explanation']}</p>"
                                },
                                "path": "/Incidents/Comment"
                            }
                        },
                        "Wait_for_Details": {
                            "runAfter": {},
                            "type": "Wait",
                            "inputs": {
                                "interval": {
                                    "count": 3,
                                    "unit": "Second"
                                }
                            },
                            "description": "Optional delay recommended for automated trigger, wait for the incident to gather multiple entities. Remove or lower for manual execution."
                        },
                        "Run_KQL_Query": {
                            "runAfter": {
                                "Wait_for_Details": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azuremonitorlogs-1']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "body": {
                                    "query": "SecurityIncident | where TimeGenerated > ago(30d) | where Status == \"Closed\" | summarize arg_max(TimeGenerated, *) by IncidentNumber | where Title == \"@{triggerBody()?['object']?['properties']?['title']}\"",
                                    "timerangetype": "3"
                                },
                                "path": "/queryDataV2",
                                "queries": {
                                    "subscriptions": "[subscription().subscriptionId]",
                                    "resourcegroups": "[resourceGroup().name]",
                                    "resourcetype": "Log Analytics Workspace",
                                    "resourcename": "[parameters('logAnalyticsWorkspaceName')]"
                                }
                            }
                        },
                        "Condition": {
                            "actions": {
                                "Update_incident": {
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                                            }
                                        },
                                        "method": "put",
                                        "body": {
                                            "incidentArmId": "@triggerBody()?['object']?['id']",
                                            "status": "Closed"
                                        },
                                        "path": "/Incidents"
                                    }
                                }
                            },
                            "runAfter": {
                                "Add_comment_to_incident_(V3)": [
                                    "Succeeded"
                                ]
                            },
                            "else": {
                                "actions": {}
                            },
                            "expression": {
                                "and": [
                                    {
                                        "equals": [
                                            "@json(outputs('HTTP_-_Call_Foundry')?['body']?['choices']?[0]?['message']?['content'])?['status']",
                                            "Closed"
                                        ]
                                    }
                                ]
                            },
                            "type": "If"
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azuresentinel": {
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]",
                                    "connectionId": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/connections/azuresentinel-4')]",
                                "connectionName": "azuresentinel-4",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            },
                            "azuremonitorlogs-1": {
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuremonitorlogs')]",
                                    "connectionId": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/', resourceGroup().name, '/providers/Microsoft.Web/connections/azuremonitorlogs-1')]",
                                "connectionName": "azuremonitorlogs-1",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}